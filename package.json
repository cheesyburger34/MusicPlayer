{
  "name": "musicplayer",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "music-metadata": "^11.12.3"
  },
  "nodemonConfig": {
    "ignore": [
      "*.db",
      "*.db-journal",
      "listening_history.db*",
      "library.db*",
      "musicLibrary/covers/*"
    ]
  },
  "liveServer.settings": {
    "donotVerifyTags": true,
    "ignoreFiles": [
      "**/*.db",
      "**/*.db-journal",
      "**/listening_history.db",
      "**/library.db",
      "**/musicLibrary/covers/**"
    ]
  }
}